"""Native module: document conversion, validation and the command line."""

from typing import Any, Final, final

__all__ = ["CoreError", "__version__", "cli_main", "load", "validate", "validate_bytes"]

__version__: Final[str]

@final
class CoreError:
    """One validation error, as produced by the validator."""

    @property
    def kind(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def has_details(self) -> bool: ...
    @property
    def keyword(self) -> str | None: ...
    @property
    def schema_path(self) -> list[str | int]: ...
    @property
    def instance_path(self) -> list[str | int]: ...
    @property
    def cause(self) -> str | None: ...
    def schema(self) -> Any: ...
    def instance(self) -> Any: ...
    def context(self) -> list[CoreError]: ...
    def render(self) -> str: ...

def validate(
    spec: object, version: str, base_uri: str, all_errors: bool
) -> list[CoreError]: ...
def validate_bytes(
    data: bytes,
    stream_name: str,
    base_uri: str,
    version: str | None,
    all_errors: bool,
) -> list[CoreError]: ...
def load(data: bytes, stream_name: str) -> Any: ...
def cli_main(args: list[str]) -> tuple[int, str, str, bool]: ...
